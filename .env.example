# TuniEdu Platform Environment Configuration Template
# Timezone Rule: Official school year calculations must follow Africa/Tunis

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://tuniedu_user:tuniedu_password_2026@localhost:5432/tuniedu_db?schema=public"

# -----------------------------------------------------------------------------
# Cache & Task Queue (Redis 7)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# Object Storage (MinIO S3 Compatible)
# -----------------------------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="tuniedu_admin"
S3_SECRET_KEY="tuniedu_secure_storage_2026"
S3_BUCKET_MANUSCRIPTS="tuniedu-manuscripts-raw"
S3_BUCKET_BOARDS="tuniedu-boards-rendered"
S3_REGION="us-east-1"

# -----------------------------------------------------------------------------
# National Payment Gateway Simulation (Flouci / Konnect / GPG)
# -----------------------------------------------------------------------------
FLOUCI_APP_TOKEN="flouci_test_app_token_2026"
FLOUCI_APP_SECRET="flouci_test_secret_key_sec07_hmac"
WEBHOOK_SECRET_KEY="tuniedu_webhook_hmac_secret_sha256"

# -----------------------------------------------------------------------------
# Platform & Security Settings
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PLATFORM_COMMISSION_BPS=1000 # 10% Platform fee (1000 basis points)
AUTHOR_ROYALTY_BPS=9000     # 90% Net Author share (9000 basis points)
DEFAULT_TIMEZONE="Africa/Tunis"
NODE_ENV="development"
